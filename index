    function exportToCsv() {
      const headers = ['Hari & Tanggal', 'Waktu Input', 'Nama', 'Email', 'Departemen', 'Kerjaan Harian', 'Jenis Bukti', 'Status', 'Dikunci?', 'Bukti Link / SS', 'Keterangan'];
      const rows = getFilteredTasks().map(t => {
        const m = getMemberById(t.memberId);
        const proofVal = t.proofType === 'none' ? 'Tanpa Bukti' : t.proofType === 'link' ? (t.proofLink || '') : (t.proofImage ? '1 Foto Screenshot Terlampir' : '');
        return [
          formatHariTanggal(t.date),
          t.inputTime || '',
          m.name,
          m.email,
          t.category,
          t.title,
          t.proofType,
          t.status,
          t.isLocked ? 'Terkunci' : 'Terbuka',
          proofVal,
          t.notes || ''
        ].map(c => `"${String(c).replace(/"/g, '""')}"`).join(',');
      });

      const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows].join('\n');
      const link = document.createElement('a');
      link.setAttribute('href', encodeURI(csvContent));
      link.setAttribute('download', `kpi-niagakara-mitra-juara-${state.startDate}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('File CSV PT Niagakara Mitra Juara berhasil diunduh!');
    }

