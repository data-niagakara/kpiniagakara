          overdueCount++;
        }

        const proofOk = isTaskProofValid(t);
        if (t.status === 'Done') {
          if (proofOk) {
            doneVerified++;
            earnedPoints += weight;
          } else {
            doneUnverified++;
            earnedPoints += weight * 0.5;
          }
        } else if (t.status === 'In Progress') {
          inProgress++;
        } else {
          pending++;
        }
      });

      const doneTotal = doneVerified + doneUnverified;
      const kpiScore = totalMaxPoints > 0 ? Math.round((earnedPoints / totalMaxPoints) * 100) : 0;
      const completionRate = totalTasks > 0 ? Math.round((doneTotal / totalTasks) * 100) : 0;
      const proofRate = doneTotal > 0 ? Math.round((doneVerified / doneTotal) * 100) : 100;

      return {
        totalTasks,
        doneTotal,
        doneVerified,
        doneUnverified,
        inProgress,
        pending,
        lockedCount,
        overdueCount,
        totalMaxPoints,
        earnedPoints,
        kpiScore,
        completionRate,
        proofRate
      };
    }

