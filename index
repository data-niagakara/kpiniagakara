    function renderDashboard() {
      const filteredTasks = getFilteredTasks();
      const m = calculateMetrics(filteredTasks);

      const badgeEl = document.getElementById('badgeUnverified');
      badgeEl.textContent = m.doneUnverified;
      badgeEl.classList.toggle('hidden', m.doneUnverified === 0);

      document.getElementById('kpiScoreValue').textContent = m.kpiScore + '%';
      document.getElementById('kpiPointsDetail').textContent = `${m.earnedPoints} dari ${m.totalMaxPoints} poin bobot`;

      // Update Odometer Needle & Arc (Semi-circle length ~ 251.3, angle -90deg to +90deg)
      const clampedScore = Math.max(0, Math.min(100, m.kpiScore));
      const angleDeg = -90 + (clampedScore / 100) * 180;
      const arcLen = (clampedScore / 100) * 251.3;
      const needleEl = document.getElementById('odometerNeedle');
      const arcEl = document.getElementById('odometerArcPath');
      if (needleEl) {
        needleEl.setAttribute('transform', `rotate(${angleDeg} 100 100)`);
      }
      if (arcEl) {
        arcEl.setAttribute('stroke-dasharray', `${arcLen} 300`);
        arcEl.setAttribute('stroke', clampedScore >= 85 ? '#10b981' : clampedScore >= 70 ? '#4f46e5' : '#f43f5e');
      }

      const gradeEl = document.getElementById('kpiScoreGrade');
      if (m.kpiScore >= 85) {
        gradeEl.textContent = 'Excellent';
        gradeEl.className = 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700';
      } else if (m.kpiScore >= 70) {
        gradeEl.textContent = 'On Track';
        gradeEl.className = 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-700';
      } else {
        gradeEl.textContent = 'Evaluasi';
