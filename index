        }
        const isActive = bTab === tabId;
        btn.className = isActive
          ? 'tab-btn flex-1 sm:flex-initial text-center px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap transition flex items-center justify-center gap-1'
