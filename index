<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PT Niagakara Mitra Juara</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .custom-scrollbar::-webkit-scrollbar {
      height: 5px;
      width: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- FULL-SCREEN GOOGLE LOGIN GATE (HANYA KOLOM EMAIL & TOMBOL LOGIN) -->
  <div id="loginGateScreen" class="min-h-screen flex flex-col justify-center items-center px-4 py-6 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="p-6 text-center border-b border-slate-100 bg-slate-50/70">
        <div class="w-20 h-20 rounded-2xl bg-white border border-slate-200 p-2 flex items-center justify-center mx-auto mb-3 shadow-sm overflow-hidden">
          <img src="https://cdn.phototourl.com/member/2026-08-18-34756943-176f-45a8-8a61-3de896b78097.jpg" alt="Logo PT Niagakara Mitra Juara" class="max-w-full h-auto max-h-16 object-contain rounded-lg" />
        </div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-100 text-indigo-800 mb-1">
          PT Niagakara Mitra Juara
        </div>
        <h1 class="text-lg sm:text-xl font-bold text-slate-900">KPI Daily Work Niagakara</h1>
        <p class="text-xs text-slate-500 mt-1">Masukkan email Akun Google yang telah terdaftar oleh Admin</p>
      </div>

      <div class="p-6 space-y-4">
        <form id="formGoogleGateLogin" class="space-y-4">
          <div>
            <label for="gateEmailInput" class="block text-xs font-semibold text-slate-700 mb-1.5">Alamat Email Google Terdaftar</label>
            <div class="relative">
              <input type="email" id="gateEmailInput" required placeholder="Masukkan email Google Anda..." class="w-full rounded-xl border border-slate-300 pl-10 pr-3.5 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
              <span class="absolute left-3.5 top-3.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.14C3.26 21.3 7.31 24 12 24z"/>
                  <path fill="#FBBC05" d="M5.28 14.24c-.24-.72-.38-1.49-.38-2.24s.14-1.52.38-2.24V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.99-3.14z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.99 3.14c.95-2.85 3.6-4.96 6.72-4.96z"/>
                </svg>
              </span>
            </div>
            <p id="gateLoginError" class="hidden text-xs text-rose-600 font-medium mt-2 bg-rose-50 border border-rose-200 rounded-lg p-2.5"></p>
          </div>
          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-3 rounded-xl shadow-sm transition flex items-center justify-center gap-2">
            <span>Masuk dengan Akun Google</span>
            <span>→</span>
          </button>
        </form>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 text-[11px] text-slate-500 leading-relaxed flex items-start gap-2">
          <span class="text-emerald-600 font-bold shrink-0">🔒</span>
          <span><strong>PT Niagakara Mitra Juara:</strong> Hanya email yang sudah terdaftar di bagian Admin (Menu User) yang dapat masuk ke dashboard.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- APP SHELL (ULTRA-COMPACT TANPA HEADER BESAR YANG MENGGANGGU) -->
  <div id="appShell" class="hidden min-h-screen flex flex-col">

    <!-- Compact Navigation & Filter Bar (Tidak Sticky / Hemat Ruang di HP) -->
    <div class="bg-white border-b border-slate-200">
      <!-- Single-Line Top Bar: Mini Logo + Navigation Tabs + Filter Toggle + Logout -->
      <div class="max-w-7xl mx-auto px-2.5 sm:px-5 py-2 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <img src="https://cdn.phototourl.com/member/2026-08-18-34756943-176f-45a8-8a61-3de896b78097.jpg" alt="Logo" class="w-7 h-7 object-contain rounded border border-slate-200 shrink-0" />
          <span class="text-xs sm:text-sm font-bold text-slate-900 truncate">PT Niagakara Mitra Juara</span>
          <span id="headerDeptBadge" class="hidden sm:inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">Portal</span>
        </div>

        <div class="flex items-center gap-1.5">
          <!-- Toggle Filter Kalender Button (Hemat Tempat di HP) -->
          <button type="button" id="btnToggleFilterDrawer" class="inline-flex items-center gap-1 text-[11px] font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg transition">
            <span>📅 Filter</span>
            <span id="filterDrawerArrow">▾</span>
          </button>

          <button id="btnOpenCloudSyncModal" type="button" class="inline-flex items-center gap-1 text-[11px] font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 px-2.5 py-1.5 rounded-lg transition" title="Koneksi Database Google Sheets Terkunci Permanen">
            <span id="cloudStatusDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="cloudTopBtnText">☁️ Cloud Sheets</span>
          </button>

          <button id="btnExportCsv" type="button" class="inline-flex items-center gap-1 text-[11px] font-semibold bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 rounded-lg transition" title="Download CSV">
            <span class="hidden sm:inline">Export </span><span>CSV</span><span class="hidden sm:inline"> (Spreadsheet)</span>
          </button>

          <button id="btnLogoutGoogle" type="button" class="inline-flex items-center gap-1 text-[11px] font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 px-2.5 py-1.5 rounded-lg transition">
            <span>Keluar (Logout)</span>
          </button>
        </div>
      </div>

      <!-- Hidden/Subtle Active User Text for internal state binding -->
      <div class="hidden">
        <span id="activeGoogleName">-</span>
        <span id="activeGoogleEmail">-</span>
      </div>

      <!-- Collapsible Calendar Filter Panel (Bisa Dibuka/Tutup agar Layar HP Lega) -->
      <div id="collapsibleFilterPanel" class="bg-slate-50 border-t border-slate-200/80 px-2.5 sm:px-5 py-2.5">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-1.5">
            <!-- Tanggal Awal -->
            <div class="flex items-center bg-white rounded-lg px-2 py-1.5 border border-slate-300 gap-1">
              <span class="text-[10px] text-slate-400 font-medium">Awal:</span>
              <input type="date" id="filterDate" class="bg-transparent text-xs font-semibold text-slate-800 focus:outline-none w-full" value="2026-11-04" />
            </div>

            <!-- Tanggal Akhir -->
            <div class="flex items-center bg-white rounded-lg px-2 py-1.5 border border-slate-300 gap-1">
              <span class="text-[10px] text-slate-400 font-medium">Akhir:</span>
              <input type="date" id="filterEndDate" class="bg-transparent text-xs font-semibold text-slate-800 focus:outline-none w-full" value="2026-11-04" />
            </div>

            <!-- Filter Bulan & Tahun -->
            <div class="col-span-2 sm:col-span-1 flex items-center bg-white rounded-lg px-2 py-1.5 border border-slate-300 gap-1">
              <span class="text-[10px] text-slate-400 font-medium">Bln/Thn:</span>
              <select id="filterMonth" class="bg-transparent text-xs font-semibold text-slate-700 focus:outline-none flex-1">
                <option value="CUSTOM">Sesuai Tanggal</option>
                <option value="01">Januari</option>
                <option value="02">Februari</option>
                <option value="03">Maret</option>
                <option value="04">April</option>
                <option value="05">Mei</option>
                <option value="06">Juni</option>
                <option value="07">Juli</option>
                <option value="08">Agustus</option>
                <option value="09">September</option>
                <option value="10">Oktober</option>
                <option value="11" selected>November</option>
                <option value="12">Desember</option>
              </select>
              <select id="filterYear" class="bg-transparent text-xs font-semibold text-slate-700 focus:outline-none">
                <option value="2025">2025</option>
                <option value="2026" selected>2026</option>
                <option value="2027">2027</option>
              </select>
            </div>

            <!-- Preset Filter Buttons -->
            <div class="col-span-2 flex flex-wrap items-center gap-1.5">
              <button type="button" id="btnPresetToday" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition">
                Hari Berjalan (4 Nov)
              </button>
              <button type="button" id="btnPresetFullMonth" class="text-[11px] font-medium px-2.5 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition">
                1 Bulan Penuh
              </button>
              <button type="button" id="btnPresetOverdue" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-800 hover:bg-amber-100 transition">
                ⚠️ Lacak Harian Tertinggal
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <select id="filterUser" class="w-full sm:w-auto bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="ALL">Semua Anggota Tim</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs (Full-Width Scrollable & Touch Friendly di HP) -->
      <div class="max-w-7xl mx-auto px-2 sm:px-5 flex items-center justify-between gap-2 overflow-x-auto border-t border-slate-100 bg-white custom-scrollbar">
        <div class="flex items-center gap-0.5 sm:gap-1 w-full sm:w-auto">
          <button type="button" data-tab="dashboard" class="tab-btn flex-1 sm:flex-initial text-center px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap transition">
            1. Dashboard Utama & KPI
          </button>
          <button type="button" data-tab="plan" class="tab-btn flex-1 sm:flex-initial text-center px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap transition">
            2. Input List Kerjaan (Plan Pagi)
          </button>
          <button type="button" data-tab="update" class="tab-btn flex-1 sm:flex-initial text-center px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap transition flex items-center justify-center gap-1">
            <span>3. Update Status & Bukti (Spreadsheet View)</span>
            <span id="badgeUnverified" class="px-1.5 py-0.5 text-[10px] rounded-full bg-rose-100 text-rose-700 font-bold">0</span>
          </button>
          <button type="button" id="tabBtnUsers" data-tab="users" class="tab-btn hidden flex-1 sm:flex-initial text-center px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap transition flex items-center justify-center gap-1">
            <span>👤 User</span>
            <span id="badgeTotalUsers" class="px-1.5 py-0.5 text-[10px] rounded-full bg-indigo-100 text-indigo-700 font-bold">12</span>
          </button>
        </div>
        <div id="activePeriodLabel" class="hidden xl:flex items-center gap-1.5 text-[11px] font-medium text-slate-500 py-1 shrink-0">
          <span>Periode: Rabu, 04 Nov 2026</span>
        </div>
      </div>
    </div>

    <!-- Main Container (Padding lega di HP px-2.5 sm:px-5) -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-2.5 sm:px-5 py-3.5 sm:py-5 space-y-4 sm:space-y-5">

      <!-- Banner Informasi Dihilangkan Sesuai Revisi (Kontrol Aksi Cepat Ditempatkan Ringkas) -->
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2 text-xs text-slate-600">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="compactUserSummary" class="font-semibold text-slate-800">Login aktif</span>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <button type="button" id="btnLoadDeptDefaults" class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-2.5 py-1.5 rounded-lg transition">
            ⚡ Muat SOP Harian Departemen Saya
          </button>
          <button id="btnQuickAddModal" type="button" class="text-[11px] font-semibold bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 rounded-lg transition shadow-2xs">
            + Tambah Kerjaan Baru
          </button>
          <button id="btnClearAllTasksAdmin" type="button" class="hidden text-[11px] font-semibold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-2.5 py-1.5 rounded-lg transition" title="Khusus Admin: Bersihkan seluruh daftar catatan kerjaan dummy">
            🗑️ Hapus Semua Kerjaan Dummy
          </button>
          <button id="btnResetDummy" type="button" class="text-[11px] font-medium bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 px-2 py-1.5 rounded-lg transition">
            Reset Data
          </button>
        </div>
      </div>
      <!-- Hidden legacy elements so no ID reference breaks -->
      <div id="bannerRestoreBar" class="hidden">
        <button type="button" id="btnQuickLoadSopMini">⚡ Muat SOP</button>
        <button type="button" id="btnRestoreBanner">Tampilkan Banner Info ▾</button>
      </div>
      <div id="accountPermissionBanner" class="hidden">
        <button type="button" id="btnDismissBanner">✕</button>
        <div id="bannerAvatar"></div>
        <span id="bannerAccountTitle"></span>
        <span id="bannerRoleBadge"></span>
        <p id="bannerPermissionDesc"></p>
      </div>

      <!-- TAB 1: DASHBOARD UTAMA & KPI -->
      <section id="view-dashboard" class="space-y-4 sm:space-y-5">
        <!-- Row 1: Odometer Skor KPI Akhir + 4 Kartu Status Task (Total Task, Completed Task, Task on Progress, Task on Pending) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-4">

          <!-- Grafik Odometer Skor KPI Akhir (lg:col-span-4) -->
          <div class="lg:col-span-4 bg-white rounded-xl p-4 border border-slate-200 shadow-2xs flex flex-col items-center justify-between">
            <div class="w-full flex items-center justify-between mb-1">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Skor KPI Akhir</span>
                <p id="kpiPointsDetail" class="text-[11px] text-slate-500">0 dari 0 poin bobot</p>
              </div>
              <span id="kpiScoreGrade" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Excellent</span>
            </div>

            <!-- Odometer / Speedometer SVG Gauge with Animated Needle -->
            <div class="relative w-full max-w-[230px] pt-1 flex flex-col items-center">
              <svg viewBox="0 0 200 115" class="w-full h-auto overflow-visible">
                <!-- Background Track Arc -->
                <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#f1f5f9" stroke-width="18" stroke-linecap="round" />
                <!-- Red Zone (0 - 50%) -->
                <path d="M 20 100 A 80 80 0 0 1 100 20" fill="none" stroke="#f43f5e" stroke-width="18" stroke-linecap="round" stroke-dasharray="126 300" opacity="0.22" />
                <!-- Amber Zone (50 - 80%) -->
                <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#f59e0b" stroke-width="18" stroke-dasharray="75 300" stroke-dashoffset="-126" opacity="0.25" />
                <!-- Green Zone (80 - 100%) -->
                <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#10b981" stroke-width="18" stroke-linecap="round" stroke-dasharray="51 300" stroke-dashoffset="-201" opacity="0.25" />

                <!-- Active Value Arc -->
                <path id="odometerArcPath" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#4f46e5" stroke-width="18" stroke-linecap="round" stroke-dasharray="0 300" />

                <!-- Scale Labels -->
                <text x="12" y="113" fill="#94a3b8" font-size="9" font-weight="600">0%</text>
                <text x="92" y="11" fill="#94a3b8" font-size="9" font-weight="600">50%</text>
                <text x="172" y="113" fill="#94a3b8" font-size="9" font-weight="600">100%</text>

                <!-- Odometer Needle Group (pivots around 100,100) -->
                <g id="odometerNeedle" transform="rotate(-90 100 100)" style="transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);">
                  <polygon points="97,100 103,100 100,32" fill="#1e293b" />
                  <circle cx="100" cy="100" r="7" fill="#4f46e5" stroke="#ffffff" stroke-width="2.5" />
                </g>
              </svg>

              <div class="-mt-2 text-center">
                <span id="kpiScoreValue" class="text-2xl sm:text-3xl font-extrabold text-slate-900">0%</span>
              </div>
            </div>

            <!-- Validitas Bukti Compact Footer inside Odometer Card -->
            <div class="w-full pt-2.5 mt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500">Validitas Bukti (<strong id="kpiProofRate" class="text-slate-800">0%</strong>):</span>
              <span id="kpiProofWarning" class="text-emerald-600 font-semibold">✓ Bukti valid</span>
            </div>
            <!-- Hidden legacy bar elements -->
            <div id="kpiScoreBar" class="hidden"></div>
            <div id="kpiProofBar" class="hidden"></div>
          </div>

          <!-- 4 Kartu Status Task: Total Task, Completed Task, Task on Progress, Task on Pending (lg:col-span-8) -->
          <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-2 gap-2.5 sm:gap-3.5">

            <!-- Card 1: Total Task -->
            <div class="bg-white rounded-xl p-3.5 sm:p-4 border border-slate-200 shadow-2xs flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">Total Task</span>
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-xs">📋</span>
              </div>
              <div class="my-2">
                <div class="flex items-baseline gap-1.5">
                  <span id="kpiTotalTaskCount" class="text-2xl sm:text-3xl font-bold text-slate-900">0</span>
                  <span class="text-xs text-slate-500 font-medium">pekerjaan</span>
                </div>
                <p id="kpiVerifiedDetail" class="text-[11px] text-slate-500 mt-1">0 sudah dikunci (ceklis)</p>
              </div>
              <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                <div class="bg-slate-600 h-full rounded-full w-full"></div>
              </div>
            </div>

            <!-- Card 2: Completed Task -->
            <div class="bg-white rounded-xl p-3.5 sm:p-4 border border-emerald-200/80 shadow-2xs flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-emerald-700">Completed Task</span>
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xs">✓</span>
              </div>
              <div class="my-2">
                <div class="flex flex-wrap items-baseline gap-1.5">
                  <span id="kpiDoneCount" class="text-2xl sm:text-3xl font-bold text-slate-900">0</span>
                  <span id="kpiDonePercent" class="text-xs font-semibold text-emerald-600">(0% Selesai)</span>
                </div>
                <p id="kpiCompletedSub" class="text-[11px] text-slate-500 mt-1">0 lengkap bukti, 0 kurang bukti</p>
              </div>
              <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                <div id="kpiDoneBar" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>

            <!-- Card 3: Task on Progress -->
            <div class="bg-white rounded-xl p-3.5 sm:p-4 border border-amber-200/80 shadow-2xs flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-amber-700">Task on Progress</span>
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xs">⏳</span>
              </div>
              <div class="my-2">
                <div class="flex flex-wrap items-baseline gap-1.5">
                  <span id="kpiOnProgressCount" class="text-2xl sm:text-3xl font-bold text-slate-900">0</span>
                  <span id="kpiOnProgressPercent" class="text-xs font-semibold text-amber-600">(0%)</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">Sedang dikerjakan hari ini</p>
              </div>
              <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
