    function renderCharts(filteredTasks) {
      const barCtx = document.getElementById('teamBarChart').getContext('2d');
      const isAdm = isCurrentUserAdmin();

      const staffMembers = state.members.filter(m => m.role !== 'ADMIN');
      const membersToShow = !isAdm
        ? state.members.filter(m => m.id === state.loggedInUserId)
        : (state.selectedUser === 'ALL' ? staffMembers : staffMembers.filter(m => m.id === state.selectedUser));

      const labels = membersToShow.map(m => m.name.split(' ').slice(0, 2).join(' '));
      const kpiData = [];
      const completionData = [];

      membersToShow.forEach(m => {
        const mTasks = state.tasks.filter(t => {
          if (t.memberId !== m.id) return false;
          if (state.startDate && t.date < state.startDate) return false;
          if (state.endDate && t.date > state.endDate) return false;
          return true;
        });
        const st = calculateMetrics(mTasks);
        kpiData.push(st.kpiScore);
        completionData.push(st.completionRate);
